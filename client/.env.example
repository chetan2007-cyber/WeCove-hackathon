# ==========================================
# Client Environment Configuration (.env.example)
# ==========================================

# Base API Gateway URL (Server or proxy)
REACT_APP_API_URL=http://localhost:5000/api

# Supabase Client Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here
REACT_APP_SUPABASE_STORAGE_BUCKET=memories

# Default Region & Country Code
REACT_APP_DEFAULT_COUNTRY_CODE=+91
REACT_APP_DEFAULT_LANGUAGE=en

# Feature Flags
REACT_APP_ENABLE_OFFLINE_SYNC=true
REACT_APP_ENABLE_VOICE_COMPANION=true
