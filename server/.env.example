# ==========================================
# Server Environment Configuration (.env.example)
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Security Secrets (NEVER expose to client)
JWT_SECRET=super_secret_jwt_key_minimum_32_chars_long

# Supabase Admin Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini AI Key
GEMINI_API_KEY=your-gemini-api-key-here

# SMS Provider Credentials (Twilio / Exotel / Fast2SMS)
SMS_PROVIDER=supabase_native
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_PROVIDER_FROM_NUMBER=

# MongoDB Connection (Dual-mode / legacy fallback)
MONGO_URI=mongodb://localhost:27017/miri-db
