# ==========================================
# Root Environment Configuration Template
# ==========================================
# Copy to .env for local development

# Database & Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
STORAGE_BUCKET=memories

# Primary SMS & Phone OTP Provider (Twilio, MessageBird, Exotel, Fast2SMS)
SMS_PROVIDER=supabase_native
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_AUTH_TOKEN=
SMS_SENDER_ID=SMRITI

# AI Services (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters

# MongoDB Fallback (if operating in dual-database mode)
MONGO_URI=mongodb://localhost:27017/miri-db
